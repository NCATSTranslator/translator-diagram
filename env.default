# Copy this file to .env. The commands that use these read the .env in the
# working directory, or the nearest one above it, and a variable already set
# in the environment wins over the file.

# The Google Sheet ID that `generate-diagram --google-sheet` downloads the
# component information from.
GOOGLE_SHEET_ID=

# Optional: a GitHub token for `sync-components`. GitHub allows 60 API calls an
# hour without one and 5000 with one, and a full sync spends about 46, so it
# matters once you sync more than once an hour. It is sent to api.github.com
# and nowhere else, and only public repositories are read, so a fine-grained
# token with read-only access to public repositories is enough. If `gh` is
# logged in you can skip this and run
# `GITHUB_TOKEN=$(gh auth token) uv run sync-components` instead.
GITHUB_TOKEN=
